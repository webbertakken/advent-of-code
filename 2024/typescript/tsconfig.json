{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "bun", "vitest/globals"]
  },
  "include": ["**/*.ts"],
  "exclude": [
    "node_modules",
    "benchmarks",
    "visualisations",
    "videos",
    "wasm_optimisations/target",
    "wasm_optimisations/pkg",
    "day16-astar.ts",
    "day16-dijkstra.ts",
    "day18.ts",
    "lib/dijkstra.ts",
    "tests/day18.test.ts"
  ]
}
